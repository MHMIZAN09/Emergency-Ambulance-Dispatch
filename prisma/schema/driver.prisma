model Driver {
    id            String @id @default(uuid())
    name          String
    email         String @unique
    phone         String @unique
    licenseNumber String @unique

    ambulanceId String?    @unique
    ambulance   Ambulance? @relation(fields: [ambulanceId], references: [id])

    deletedAt DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    @@index([email])
    @@map("drivers")
}
