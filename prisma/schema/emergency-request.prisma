model EmergencyRequest {
    id            String            @id @default(uuid())
    userId        String
    user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)
    patientName   String
    patientAge    Int?
    bloodGroup    BloodGroup?
    description   String
    priority      EmergencyPriority @default(MEDIUM)
    status        EmergencyStatus   @default(REQUESTED)
    pickupAddress String
    pickupLat     Float
    pickupLng     Float

    hospitalId String?
    hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

    verifiedAt  DateTime?
    cancelledAt DateTime?
    completedAt DateTime?

    dispatches Dispatch?
    payments   Payment[]

    deletedAt DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    @@index([userId, status, deletedAt])
    @@map("emergency_requests")
}
